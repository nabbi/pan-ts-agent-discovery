#!/usr/bin/expect
# nic@boet.cc

log_user 0
set timeout 45

proc help {} {
    puts "PAN: configure TS Agents in Panorama"
    puts "Usage:   $::argv0 add <panorama> \"object,hostname\""
    puts "Usage:   $::argv0 delete <panorama> \"object\""
    exit 64
} 

set path [file dirname [file normalize [info script]]]
source $path/myexpect.exp
source $path/../inc/config.tcl


# define vars
if { [llength $argv] != 3 } {
    puts "Incorrect number of arguments"
    [help]
}

set action [string tolower [lindex $argv 0]]
set hostname [string tolower [lindex $argv 1]]
set input [string tolower [lindex $argv 2]]

# spawn ssh
source $path/ssh-init.exp

###########

# output config with set commands
send "set cli config-output-format set\r"
myexpect "$prompt>"

# enter config mode
send "configure\r"
myexpect "$prompt#"


# input is processed as tcl lists -- $input itself is walked as a Tcl list
# below, and Tcl list-whitespace includes \r, not just space/tab/newline. A
# caller that fails to gate object/host (discover.tcl/purge.tcl both do
# today) could pass a single "object,host" entry containing an embedded \r
# or space, which would silently fan out into extra list elements here, each
# turned into its own live `send`. Validate object/host independently rather
# than trust the caller, per the hostname-charset policy applied at the
# mydig call site.
set skipped_gate 0
if {[string match $action "add"]} {
    foreach i $input {
        set object [lindex [split $i ","] 0]
        set hostname [lindex [split $i ","] 1]
        if { ![regexp {^[A-Za-z0-9._-]+$} $object] || ![regexp {^[A-Za-z0-9._-]+$} $hostname] } {
            send_user "\n## Skipping suspicious add entry: $i\n"
            incr skipped_gate
            continue
        }
        send "set template $config(template) config vsys $config(vsys) ts-agent $object host $hostname port 5009 disabled no\r"
        myexpect "$prompt#"
    }

} elseif { [string match $action "delete"] } {
    foreach object $input {
        if { ![regexp {^[A-Za-z0-9._-]+$} $object] } {
            send_user "\n## Skipping suspicious delete entry: $object\n"
            incr skipped_gate
            continue
        }
        send "delete template $config(template) config vsys $config(vsys) ts-agent $object\r"
        myexpect "$prompt#"
    }

}

# how many of the attempted objects actually changed the candidate config --
# every "delete" that hit "Object doesn't exist" (tallied in skipped_deletes by
# myexpect) was a no-op, not a change, and neither was any entry the charset
# gate above rejected before ever sending it. Deliberately gate BOTH commit and
# commit-all on this, not just commit: an empty commit is an edge case not
# worth risking (e.g. on PAN-OS versions/behaviors where a no-change partial
# commit errors instead of no-op'ing), and skipping commit-all alongside it
# avoids an unconditional 15s wait + push to every template-stack on cycles
# that changed nothing. Accepted tradeoff: if a *prior* run committed
# successfully but died before reaching commit-all (e.g. a network blip),
# that backlog won't get pushed by an all-already-absent cycle -- only by
# some later run that has a genuine new change to commit.
set skipped 0
if { [info exists skipped_deletes] } { set skipped $skipped_deletes }
set modified [expr {[llength $input] - $skipped - $skipped_gate}]

# commit comment - escaping spaces was not running clean, do not use them here
set description "BackgroundInfrastructureTask-TerminalServicesAgent"

if { $modified > 0 } {
    # commit
    send "commit description $description partial admin $config(username)\n"
    myexpect "$prompt#"
} else {
    puts "## Nothing to commit -- no candidate config changes were made\n"
}

# exit config mode
send "exit\r"
myexpect "$prompt>"

if { $modified > 0 } {
    # commit-all to each template-stacks
    after 15000
    foreach stack $config(templatestacks) {
        send "commit-all template-stack description $description name $stack\r"
        myexpect "$prompt>"
    }
}

###########

# close shell
send "exit\r"
expect eof

if { [info exists skipped_deletes] && $skipped_deletes > 0 } {
    puts "## Warning: $skipped_deletes delete target(s) were already absent (config out of sync between firewall and Panorama template) -- continued\n"
}

puts "Success"
exit 0
